TG_BOT_TOKEN=your_telegram_bot_token
# VK community token (for vk_bot.py); VK_GROUP_ID is detected automatically if omitted
# VK_GROUP_TOKEN=
# VK_GROUP_ID=
# Optional: proxy for Telegram and YouTube if the server cannot reach them,
# e.g. socks5h://127.0.0.1:1080. YT_PROXY overrides it for YouTube only.
# PROXY_URL=
# YT_PROXY=
